# Optional: enables Gemini headline analysis. Keep the secret key out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# NSE's public Streamable HTTP MCP server; no account key is required.
NSE_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp

# Optional local-server overrides.
PORT=4173
NEWS_REFRESH_SECONDS=90
QUOTE_REFRESH_SECONDS=60
