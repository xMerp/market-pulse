# Optional: enables Gemini headline analysis. Keep the secret key out of Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Primary quote provider. Groww access tokens expire daily at 6:00 AM.
# Keep this value in server-side environment variables only.
GROWW_ACCESS_TOKEN=

# Optional for local private snapshot storage; Vercel Blob injects this when linked.
BLOB_READ_WRITE_TOKEN=
SNAPSHOT_WRITE_INTERVAL_SECONDS=300

# Optional fallback: NSE's public Streamable HTTP MCP server.
NSE_MCP_URL=https://mcp.nseindia.in/cmmkt/mcp

# Optional local-server overrides.
PORT=4173
NEWS_REFRESH_SECONDS=90
QUOTE_REFRESH_SECONDS=60
